# Script
#     qbmmReport
#
#     qbmmReport -site <siteDir> [-tests <log>] [<root> ...]
#     qbmmReport -output <dir> [-tests <log>] [-style <css>] [<root> ...]
#
# Description
#     Write the validation dashboard of the cases under the roots (the
#     validation directory of the sources unless given) into <dir>, or into
#     the validation directory of the site with -site:
#
#         index.html      the dashboard page
#         results.json    the state of every case, its comparisons with its
#                         reference data, its check against its baseline,
#                         and the unit tests
#         history.json    the same in brief for every commit reported into
#                         <dir> before, so that the page shows how each
#                         comparison moved
#         figures/        the figures of every case that ran, as SVG
#
#     A case is any directory with a validation/validationDict or a
#     regression/baseline. Nothing is run: each case is reported in the
#     state its last run left it in. -tests reads the unit tests from the
#     output of test/Allrun.
#
#     -site names the directory of the exported OpenQBMM site, whose home
#     page links the dashboard as validation/. The page is written there,
#     with the header and the footer of the home page, so that its links
#     are the ones the site has, and with the stylesheet of the site,
#     industry.css, so that it follows the theme. Without a site, -style
#     copies a stylesheet next to the page.
#
#     The figures need matplotlib, and the dashboard is not written without
#     it. Nothing is published: the directory is written, and putting it on
#     the site is a separate step.
#
#------------------------------------------------------------------------------

import json
import os
import shutil
import sys

bin = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(bin, 'python'))

from qbmm import report, validation                           # noqa: E402

usage = (
    "usage: qbmmReport -site <siteDir> [-tests <log>] [<root> ...]\n"
    "       qbmmReport -output <dir> [-tests <log>] [-style <css>] "
    "[<root> ...]\n"
)


def main(argv):
    output = None
    tests = None
    style = None
    site = None
    roots = []

    args = argv[1:]

    while args:
        arg = args.pop(0)

        if arg == '-output' and args:
            output = args.pop(0)
        elif arg == '-tests' and args:
            tests = args.pop(0)
        elif arg == '-style' and args:
            style = args.pop(0)
        elif arg == '-site' and args:
            site = args.pop(0)
        elif arg.startswith('-'):
            sys.stderr.write(usage)
            return 2
        else:
            roots.append(arg)

    chrome = None

    if site:
        chrome = report.siteChrome(site)

        if chrome is None:
            sys.stderr.write(
                "qbmmReport: %s has no index.html with a header linking "
                "validation/ and a footer\n" % site
            )
            return 2

        output = output or os.path.join(site, 'validation')

    if not output or (site and style):
        sys.stderr.write(usage)
        return 2

    try:
        from qbmm import plotting
    except ImportError as e:
        sys.stderr.write(
            "qbmmReport: %s: the dashboard needs matplotlib for its figures\n"
            % e
        )
        return 1

    top = os.path.dirname(bin)
    roots = roots or [os.path.join(top, 'validation')]

    records = []

    for case, caseTop in report.findCases(roots):
        record, spec = report.collectCase(case, caseTop, bin)

        if spec is not None and record['status'] != 'notRun':
            outDir = os.path.join(output, 'figures', record['path'])

            for figure in spec.figures:
                computed = {c.name for c in figure.curves if c.computed}

                try:
                    written, missing = plotting.draw(
                        figure, spec.base, outDir, ['svg']
                    )
                except validation.ValidationError as e:
                    sys.stderr.write("qbmmReport: %s\n" % e)
                    continue

                # A figure without the curves the case computed shows
                # nothing of the case
                if computed & {name for name, _ in missing}:
                    for path in written:
                        os.remove(path)
                    continue

                record['figures'].append({
                    'name': figure.name,
                    'file': os.path.relpath(written[0], output),
                })

        records.append(record)

        print("qbmmReport: %-8s %s" % (record['status'], record['path']))

    unitTests = report.unitTests(tests) if tests else []

    result = {
        'build': report.build(top),
        'summary': report.summary(records, unitTests),
        'cases': records,
        'tests': unitTests,
    }

    os.makedirs(output, exist_ok=True)

    with open(os.path.join(output, 'results.json'), 'w') as f:
        json.dump(result, f, indent=1)

    historyPath = os.path.join(output, 'history.json')
    history = []

    if os.path.isfile(historyPath):
        with open(historyPath) as f:
            history = json.load(f)

    history = report.mergeHistory(history, report.historyEntry(result))

    with open(historyPath, 'w') as f:
        json.dump(history, f, indent=1)

    # The page carries its data as well, so that it opens from the disk,
    # where a browser does not let it fetch the files next to it
    with open(os.path.join(bin, 'python', 'qbmm', 'dashboard.html')) as f:
        template = f.read()

    page = report.page(
        template, json.dumps({'results': result, 'history': history}),
        chrome, '../industry.css' if site else 'industry.css'
    )

    with open(os.path.join(output, 'index.html'), 'w') as f:
        f.write(page)

    if style:
        shutil.copy(style, os.path.join(output, 'industry.css'))

    s = result['summary']
    print(
        "qbmmReport: %d cases, %d passed, %d failed, %d not run; "
        "written to %s" % (s['cases'], s['passed'], s['failed'],
                           s['notRun'], output)
    )

    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))

#------------------------------------------------------------------------------
