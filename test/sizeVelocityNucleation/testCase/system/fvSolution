FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "moment.*"
    {
        solver          PBiCG;
        preconditioner  DILU;
        tolerance       1e-30;
        relTol          0;
    }
}

