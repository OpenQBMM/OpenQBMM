FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     Test-SizeVelocityNucleation;

startFrom       startTime;

startTime       0;

stopAt          endTime;

//  One step, of a length that makes the nuclei a few per cent of what is
//  already there: small enough to stay a perturbation, large enough that
//  the change is far above round-off in every moment
endTime         1;

deltaT          1;

writeControl    timeStep;

writeInterval   1000;

purgeWrite      0;

writeFormat     ascii;

writePrecision  16;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable false;

// ************************************************************************* //
