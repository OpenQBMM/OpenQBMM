#!/bin/sh
cd "${0%/*}" || exit                            # Run from this directory
#------------------------------------------------------------------------------

wclean populationBalanceModel
wclean populationBalanceSubModels
wclean sizeVelocityNucleation
wclean realizableOdeSolver
wclean all momentSets
wclean all momentInversions
wclean momentAdvection
wclean momentAdvection/univariate
wclean momentAdvection/velocity
wclean univariateQuadratureApproximation
wclean Vandermonde
wclean GolubWelsch
wclean mappedList
wclean mappedPtrList
wclean univariateMomentAdvection/setMoments1D
wclean univariateMomentAdvection/setMoments2D

# Cleaning logs in case tests were executed
rm -f log.*

# Cleaning what the tests that run on a case leave behind, so that a run of
# the suite does not show up as a change to the repository
cleanTestCase()
{
    [ -d "$1" ] || return 0

    (
        cd "$1" || exit 0

        foamListTimes -rm > /dev/null 2>&1

        # Quadrature fields written next to the moments of the initial time
        rm -f 0/weight.* 0/abscissa*.* 0/sigma.*

        rm -f log.*
    )
}

cleanTestCase univariateQuadratureApproximation/testCase
cleanTestCase populationBalanceModel/testCase
cleanTestCase momentAdvection/univariate/cases/firstOrderKinetic
cleanTestCase momentAdvection/univariate/cases/zeta
cleanTestCase momentAdvection/univariate/cases/zetaZeroOne
cleanTestCase momentAdvection/velocity/cases/crossing
cleanTestCase momentAdvection/velocity/cases/crossingVikas
cleanTestCase momentAdvection/velocity/cases/thermalVikas
cleanTestCase momentAdvection/velocity/cases/reflectiveElastic
cleanTestCase momentAdvection/velocity/cases/reflectiveInelastic
cleanTestCase momentAdvection/velocity/cases/fixedTemperature
cleanTestCase momentAdvection/velocity/cases/noFlux
cleanTestCase momentAdvection/velocity/cases/symmetry
cleanTestCase momentAdvection/velocity/cases/outflow

#------------------------------------------------------------------------------
