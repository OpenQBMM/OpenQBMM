FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      advectionTestDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The zeta scheme over R+ on the bimodal profile, whose number of nodes
// changes from cell to cell, at the Courant limit the scheme reports in
// one dimension
profile         bimodal;

support         RPlus;

Co              0.5;

// The limiter of the zeta scheme decides on a realizability test of m*,
// which the mirrored runs can settle differently in a cell where m* is on
// the boundary of the moment space within round-off: measured 2e-3 here
// with the limiter right, 12 with the search counting the wrong faces
mirrorTolerance 1e-2;

checks          (conservation realizability mirror accuracy);

// The Euler step of the transport model hides the order of the scheme at
// its Courant limit, so the comparison with the first-order scheme runs at
// a smaller one
accuracyCo      0.1;

accuracyRatio   0.5;


// ************************************************************************* //
