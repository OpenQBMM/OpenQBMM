FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      quadratureProperties.mixture;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

fieldMomentInversion basicMultivariateFieldMomentInversion;

// Three nodes of the mixture fraction, each carrying the mean of one
// composition. The supports are the model's, so they are not given here.
basicMultivariateMomentInversion
{
    type                conditionalMeans;
    nMoments            6;
    nScalars            1;
    nVelocityDimensions 0;

    basicQuadrature
    {
        univariateMomentInversion   Gauss;
    }
}

momentAdvection
{
    velocityMomentAdvection firstOrderFluidVelocity;
}

// ************************************************************************* //
