FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      advectionTestDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The same two beams with the Vikas scheme, whose weights are limited:
// no exact shift, but conservation, realizability and symmetry. At a
// Courant number of one half, within the limit the scheme reports, the
// monokinetic beams blow up: the weights are reconstructed node by node
// and the nodes of a cell holding both beams are not those of a cell
// holding one
beams
(
    { centre 0.3; width 0.3; alpha 1e-3; U ( 1 0 0); Theta (0 0 0); }
    { centre 0.7; width 0.3; alpha 2e-3; U (-1 0 0); Theta (0 0 0); }
);

Co              0.25;

// The limited weights cost more arithmetic per face than upwinding, and
// the two runs agree to round-off of that arithmetic
conservationTolerance 1e-10;

mirrorTolerance 1e-10;

checks          (conservation realizability mirror);

// ************************************************************************* //
