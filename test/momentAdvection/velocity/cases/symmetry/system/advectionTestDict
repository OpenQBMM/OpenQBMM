FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      advectionTestDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Symmetry planes mirror the population: nothing leaves and the kinetic
// energy is conserved
beams
(
    { centre 0.5; width 0.6; alpha 1e-3; U (0.5 0 0); Theta (0.2 0.2 0.2); }
);

Co              0.5;

energyConserved true;

checks          (mass energy realizability);

