#!/bin/sh

cd "${0%/*}" || exit                            # Run from this directory
#------------------------------------------------------------------------------
# A failing test does not stop the ones after it, so that a single run reports
# everything that is broken, but the suite exits non-zero so that a caller sees
# it. A test that was never built exits 127 and is reported the same way.

nFail=0
failed=""

runTest()
{
    _dir="$1"
    _test="$2"

    echo "Running $_test"

    if ( cd "$_dir" && "$_test" )
    then
        echo "$_test: passed"
    else
        echo "$_test: FAILED"
        nFail=$((nFail + 1))
        failed="$failed $_test"
    fi

    echo
}

# Basic functionality
runTest . Test-Vandermonde
runTest . Test-GolubWelsch
runTest . Test-MappedList
runTest . Test-MappedPtrList

# Moment sets
runTest . Test-UnivariateMomentSet
runTest . Test-MultivariateMomentSet

# Quadrature algorithms
runTest ./momentInversions/univariate/univariateMomentInversion \
    Test-UnivariateMomentInversion

runTest ./momentInversions/univariate/extendedMomentInversion \
    Test-ExtendedMomentInversion

runTest ./momentInversions/multivariate/CHyQMOMMomentInversion \
    Test-CHyQMOMMomentInversion

runTest ./momentInversions/multivariate/monoKineticMomentInversion \
    Test-monoKineticMomentInversion

runTest ./momentInversions/multivariate/sizeCHyQMOMMomentInversion \
    Test-sizeCHyQMOMMomentInversion

runTest ./momentInversions/multivariate/TensorProductMomentInversion \
    Test-TensorProductMomentInversion

runTest ./momentInversions/multivariate/conditionalMomentInversion \
    Test-ConditionalMomentInversion

# Self-contained: it builds its own moment sets rather than reading a
# quadratureProperties from its directory
runTest . Test-CHyQMOMDegenerate

# Moment advection
runTest . Test-MomentAdvection

# Field level. These were built by test/Allwmake but never run, so nothing
# above the moment inversions was exercised at all.
runTest ./univariateQuadratureApproximation/testCase \
    Test-UnivariateQuadratureApproximation

# Source terms of the aggregation, breakup and growth models
runTest ./populationBalanceSubModels/testCase \
    Test-PopulationBalanceSubModels

# Source of the nucleation of particles in a size-velocity population
# balance, whose nuclei are born with the velocity of the continuous phase
runTest ./sizeVelocityNucleation/testCase \
    Test-SizeVelocityNucleation

# The realizable ODE solver integrates a source over every step, whatever
# the lengths of the steps and however small the moments are in their units,
# and subdivides a step its tolerances ask it to, on a source stiff enough
# to need it
runTest ./realizableOdeSolver/testCase \
    Test-RealizableOdeSolver

runTest ./realizableOdeSolver/stiffCase \
    Test-RealizableOdeSolver

if [ "$nFail" -gt 0 ]
then
    echo "$nFail test(s) failed:$failed"
    exit 1
fi

echo "All tests passed"

#------------------------------------------------------------------------------
