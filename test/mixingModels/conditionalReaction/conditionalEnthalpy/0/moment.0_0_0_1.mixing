FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      moment.0_0_0_1.mixing;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 101850.00000000003;

boundaryField
{
    ".*"
    {
        type            zeroGradient;
    }
}

