FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      mixingProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

mixingModel conditionalMixing;

conditionalMixingCoeffs
{
    nCompositions   2;

    diffusionModel
    {
        mixingDiffusionModel  none;
    }

    mixingKernel
    {
        mixingKernel  none;
        Cphi          Cphi    [ 0 0 0 0 0 0 0 ] 2.0;
    }

    reaction
    {
        reactionModel   chemistry;
        temperature     linearEnthalpy;

        // Pure B at xi = 0 and pure A at xi = 1, both at 300 K
        streams
        {
            xi0 { T 300; Y { B 1; } }
            xi1 { T 300; Y { A 1; } }
        }
    }

    odeCoeffs
    {
        solveOde   on;
        ATol       1.0e-12;
        RTol       1.0e-9;
        fac        0.9;
        facMin     0.5;
        facMax     2.0;
        minLocalDt 1.0e-8;
    }
}

