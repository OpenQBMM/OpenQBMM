FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      chemistryProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

chemistryType
{
    solver          ode;
    method          standard;
}

chemistry               on;

initialChemicalTimeStep 1e-3;

odeCoeffs
{
    solver          seulex;
    absTol          1e-15;
    relTol          1e-10;
}

