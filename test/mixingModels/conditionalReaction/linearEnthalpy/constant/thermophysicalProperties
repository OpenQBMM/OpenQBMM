// The species A and B, the same gas apart from the heat of formation of A:
// the reaction A = B is thermally neutral in mass and exothermic
thermoType
{
    type            hePsiThermo;
    mixture         reactingMixture;
    transport       const;
    thermo          hConst;
    energy          sensibleEnthalpy;
    equationOfState perfectGas;
    specie          specie;
}

inertSpecie             B;

