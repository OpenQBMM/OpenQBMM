FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      populationBalanceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

populationBalanceModel univariate;

univariateCoeffs
{
    aggregation off;
    breakup     off;
    nucleation  off;

    diffusionModel
    {
        diffusionModel  none;
    }

    //  Evaporation at a rate that diverges as a droplet vanishes, whose
    //  effect on the moments is known in closed form: the d-square law
    //  takes the square of every size down by Cg t / pi
    growth on;
    growthModel
    {
        growthModel     nonLinearEvaporation;
        Cg              6.7e-10;
    }

    //  Tolerances no solver can meet, since the error estimate of a step
    //  cannot fall below round-off, with a floor of the local step that is
    //  reached after twenty halvings: the run has to end there, with a
    //  message, rather than shrink its step without end
    odeCoeffs
    {
        solveOde   on;
        ATol       1.0e-20;
        RTol       1.0e-20;
        fac        0.9;
        facMin     0.5;
        facMax     2.0;
        minLocalDt 1.0e-6;
    }
}

