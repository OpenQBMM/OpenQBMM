FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     Test-RealizableOdeSolver;

startFrom       startTime;

startTime       0;

stopAt          endTime;

//  The test sets the length of every step itself, and stops after forty
endTime         1;

deltaT          1.0e-3;

writeControl    timeStep;

writeInterval   1000;

purgeWrite      0;

writeFormat     ascii;

writePrecision  16;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable false;

// ************************************************************************* //
