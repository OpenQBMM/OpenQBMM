FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      mixingProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

mixingModel turbulentMixing;

turbulentMixingCoeffs
{
    //  A single cell: nothing is transported and nothing diffuses
    diffusionModel
    {
        mixingDiffusionModel  none;
    }

    //  Interaction by exchange with the mean: the mean is conserved and the
    //  variance decays at Cphi epsilon/k
    mixing on;
    mixingKernel
    {
        mixingKernel  IEM;
        Cphi          Cphi    [ 0 0 0 0 0 0 0 ] 2.0;
    }

    //  Tolerances far below what the checks ask for
    odeCoeffs
    {
        solveOde   on;
        ATol       1.0e-12;
        RTol       1.0e-9;
        fac        0.9;
        facMin     0.5;
        facMax     2.0;
        minLocalDt 1.0e-8;
    }
}

