# Script
#     AllrunFunctions
#
# Description
#     Failure reporting for the Allrun scripts that run a set of cases.
#
#     A script that runs its cases in a subshell and looks at nothing exits
#     zero whether they ran or not, so a case that fails is invisible to the
#     caller. Source this file after RunFunctions, run each case with
#     runCase, and end the script with reportCases.
#
#     A failing case does not stop the ones after it, so that a single run
#     reports everything that is broken, but the script exits non-zero so
#     that a caller sees it. This is what test/Allrun does for the unit
#     tests and what the Allwmake scripts do for the build.
#
#------------------------------------------------------------------------------

nFail=0
failed=""

#- Run the Allrun of one case, recording a failure rather than passing over it
runCase()
{
    echo "Running $1"

    if [ ! -x "$1/Allrun" ]
    then
        echo "$1: no Allrun to run"
        nFail=$((nFail + 1))
        failed="$failed
    $1 (no Allrun)"
        return 1
    fi

    if ( cd "$1" && ./Allrun )
    then
        #  Both checks are made, so that one failing does not hide the
        #  other, and the case fails if either of them does
        checkRegression "$1"
        _regression=$?

        checkReference "$1"
        _reference=$?

        return $((_regression + _reference))
    fi

    nFail=$((nFail + 1))
    failed="$failed
    $1"

    return 1
}

#- Run one step of a case, stopping the case if the step fails. The run
#  functions of OpenFOAM return the status of the application, but a script
#  that does not look at it carries on to the next step and then exits with
#  the status of whatever it happened to run last, which is often a script
#  that draws a graph.
runStep()
{
    #  runApplication writes the output of the application to its log file
    #  and only a line of its own to the terminal, so holding that line to
    #  read it costs nothing.
    _out=$(runApplication "$@" 2>&1)
    _status=$?

    echo "$_out"

    #  A step whose log file is already there is not run, and runApplication
    #  reports that as a success. The case then carries the results of
    #  whatever ran before, which is what a comparison would be made
    #  against, so it is a failure here.
    case "$_out" in
    (*"already run on"*|*"already exists"*)
        echo "FAILED: $* was skipped in $PWD" 1>&2
        echo "        Run Allclean first: the case still holds an old run." 1>&2
        exit 1
        ;;
    esac

    if [ "$_status" -eq 0 ]
    then
        return 0
    fi

    echo "FAILED: $* in $PWD" 1>&2
    exit 1
}

#- Run one step of a case in parallel, stopping the case if it fails
runStepParallel()
{
    _out=$(runParallel "$@" 2>&1)
    _status=$?

    echo "$_out"

    #  As in runStep, a step that was not run is not a step that passed
    case "$_out" in
    (*"already run on"*|*"already exists"*)
        echo "FAILED (parallel): $* was skipped in $PWD" 1>&2
        echo "        Run Allclean first: the case still holds an old run." 1>&2
        exit 1
        ;;
    esac

    if [ "$_status" -eq 0 ]
    then
        return 0
    fi

    echo "FAILED (parallel): $* in $PWD" 1>&2
    exit 1
}

#- The directory of the OpenQBMM sources, found by walking up from the
#  case, so that a case at any depth can reach the scripts in bin
qbmmRoot()
{
    _dir="$PWD"

    while [ "$_dir" != "/" ]
    do
        if [ -x "$_dir/bin/qbmmRegression" ]
        then
            echo "$_dir"
            return 0
        fi

        _dir=$(dirname "$_dir")
    done

    return 1
}

#- Compare a case with the baseline it recorded, and record the failure
#
#  A case without a baseline is not a failure: recording one is a decision
#  to take case by case, with qbmmRegression record, once the result of the
#  case is trusted. What the check answers is whether a change moved a case
#  that was not meant to move, which is a question about the software; the
#  graphs a case draws against the data of an experiment or of another
#  method answer whether it is right.
checkRegression()
{
    [ -f "$1/regression/baseline" ] || return 0

    _root=$(qbmmRoot) || return 0

    if "$_root"/bin/qbmmRegression check "$1"
    then
        return 0
    fi

    nFail=$((nFail + 1))
    failed="$failed
    $1 (regression)"

    return 1
}

#- Compare a case with the data it is validated against, when it declares
#  the comparisons to make
#
#  A case that declares none is not a failure: most cases ship no reference
#  data at all, and the tolerance of a case that does is a judgement about
#  physics, to be written once by whoever knows what agreement to expect.
checkReference()
{
    [ -f "$1/validation/comparisons" ] || return 0

    _root=$(qbmmRoot) || return 0

    if "$_root"/bin/qbmmCompareReference "$1"
    then
        return 0
    fi

    nFail=$((nFail + 1))
    failed="$failed
    $1 (reference)"

    return 1
}

#- Report the cases that failed, and exit non-zero if there were any
reportCases()
{
    if [ "$nFail" -gt 0 ]
    then
        echo
        echo "$nFail case(s) failed:$failed"
        echo
        exit 1
    fi

    return 0
}

