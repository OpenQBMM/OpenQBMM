{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      validationDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The figures the case draws and the comparisons it makes, read by
// qbmmPlot and qbmmCompareReference.
//
// A tolerance applies to the root mean square difference, as a fraction of
// the scale of the reference, and was set from the agreement the case was
// seen to have, with room for a change of the discretisation to move it. A
// tolerance of report is a disagreement known and still to be understood.

// The fluctuation of the pressure at the third probe, which
// validation/extractPressure writes from the probes of every start time.
// The case is not compared with the data: no tolerance has been set for it.

figures
{
    pressure
    {
        xLabel      "Time, $t$ [s]";
        yLabel      "Normalized pressure";
        xRange      (0 50);
        yRange      (-20 20);
        legend      "upper left";

        curves
        {
            Diaz
            {
                file        "experiments_7_1.data";
                label       "Diaz et al.";
                style       points;
            }

            OpenQBMM
            {
                computed    yes;
                file        "pressureFluctuation.dat";
                label       "OpenQBMM";
                every       250;
            }
        }
    }
}

