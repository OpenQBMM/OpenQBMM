#
# Script
#     extractPressure [startTime]
#
# Description
#     Write the fluctuation of the pressure at the third probe over the 50 s
#     from startTime (50 s unless given) into pressureFluctuation.dat: the
#     time from the start of the window, and the pressure less its mean over
#     the window, which is what the figure of validationDict draws.
#
#     The case is often restarted, so the probe files of every start time
#     are read, in the order of their times. Run it again after a restart,
#     and then qbmmPlot on the case.
#
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1    # Run from this directory

field=p
start=${1:-50}

for time in $(ls ../postProcessing/pProbes | sort -g)
do
    cat "../postProcessing/pProbes/$time/$field"
done | awk -v t0="$start" '
    /^#/ { next }
    $1 >= t0 && $1 <= t0 + 50 { t[n] = $1; p[n] = $4; sum += $4; n++ }
    END { for (i = 0; i < n; i++) print t[i] - t0, p[i] - sum/n }
' > pressureFluctuation.dat

