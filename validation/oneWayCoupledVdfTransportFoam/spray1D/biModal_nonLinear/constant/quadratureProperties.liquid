FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      quadratureProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

fieldMomentInversion basicMultivariateFieldMomentInversion;

basicMultivariateMomentInversion
{
    type sizeCHyQMOM;
    nVelocityDimensions         2;
    nSizeMoments                8;
    basicQuadrature
    {
        univariateMomentInversion   Gauss;
    }
}

momentAdvection
{
    velocityMomentAdvection   firstOrderKinetic;

    top
    {
        type noFlux;
    }
}
