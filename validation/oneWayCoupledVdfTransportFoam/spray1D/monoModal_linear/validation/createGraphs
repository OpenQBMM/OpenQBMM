#!/bin/bash
#
# read d43average from pbeTransportFoam
createEpsTotalMass()
{

    gnuplot<<EOF

    set terminal postscript eps enhanced color font 'Helvetica,40' linewidth 2\
        dl 8.0
    set output "monoModal_linearEvaporation_totalMass.eps"
    set xlabel "X-position [m]"
    set ylabel "Mass Density [g/cm^3]"
    set grid
    set key right top
    set size 2,2
    set xrange [0.1:0.3]
    set yrange [0:0.004]

    plot    "$1" using 1:2 title 'DQMOM (Fox 2008)'\
                with points pointtype 7 ps 3 linecolor rgb 'black',\
            "$2" using 1:(\$2*633/1000) title 'OpenQBMM' \
                with line lt 2 linewidth 5 linecolor rgb '#9db668'
EOF
}
# Where the spray has evaporated the sampled liquid velocity is zero, so
# the difference of the two velocities there is the gas velocity rather
# than a relative velocity. The curve is drawn only where liquid remains.
createEpsUr()
{

    gnuplot<<EOF

    set terminal postscript eps enhanced color font 'Helvetica,40' linewidth 2\
        dl 8.0
    set output "monoModal_linearEvaporation_Ur.eps"
    set xlabel "X-position [m]"
    set ylabel "Relative Velocity Magnitude [m/s]"
    set grid
    set key right top
    set size 2,2
    set xrange [0.1:0.3]
    set yrange [0:0.6]

    plot    "$1" using 1:2 title 'DQMOM (Fox 2008)'\
                with points pointtype 7 ps 3 linecolor rgb 'black',\
            "$2" using 1:(\$2 > 1.0e-12 ? ((\$7 - \$10)**2 + (\$8 - \$11)**2)**0.5 : 1/0) title 'OpenQBMM' \
                with line lt 2 linewidth 5 linecolor rgb '#9db668'
EOF
}
# test if gnuplot exists on the system
if ! command -v gnuplot > /dev/null 2>&1
then
    echo "gnuplot not found - skipping graph creation" >&2
    exit 1
fi

# extract data from log file and put them in a text file for gnuplot
# cat ../log.oneWayCoupledVdfTransportFoam | grep '^Time = ' | cut -c8-15 > time.tmp
# cat ../log.oneWayCoupledVdfTransportFoam | grep 'Volume averaged normalized d10' | cut -d':' -f2 > d10.tmp
# paste time.tmp d10.tmp > volumeAveragedD10.dat

#Remove temporary files
# rm time.tmp d10.tmp

# paths to data
VALIDATIONDATAROOT=./validationData
time=$(cd ../ && foamListTimes -latestTime)

echo "    processing d10 profile" > log.createGraphs 2>&1
# The sampled fields of a set are all written to a single file, named after
# the set and the fields it holds, so both graphs read the same file. Its
# columns follow the order of the fields in system/sampleDict, with the
# scalars before the vectors:
#     1: x
#     2: alpha.liquid  3: moment.000  4: moment.100  5: moment.200
#     6: moment.300    7-9: U.gas     10-12: U.liquid
OPENQBMM_data=$(ls ../postProcessing/sampleDict/"$time"/Centerline_* 2>/dev/null \
    | head -1)

if [ ! -f "$OPENQBMM_data" ]
then
    echo "No sampled data found in ../postProcessing/sampleDict/$time" >&2
    exit 1
fi

VALIDATION_mass="$VALIDATIONDATAROOT/Fox_totalMass.csv"
VALIDATION_Ur="$VALIDATIONDATAROOT/Fox_Ur.csv"

createEpsTotalMass $VALIDATION_mass "$OPENQBMM_data"
createEpsUr $VALIDATION_Ur "$OPENQBMM_data"

if command -v epstopdf > /dev/null 2>&1
then
    epstopdf *totalMass.eps
    epstopdf *Ur.eps
fi

echo Done
