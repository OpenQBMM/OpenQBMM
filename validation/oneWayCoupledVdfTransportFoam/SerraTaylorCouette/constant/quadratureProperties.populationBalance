FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      quadratureProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

fieldMomentInversion basicMultivariateFieldMomentInversion;


basicMultivariateMomentInversion
{
    type sizeCHyQMOM;
    nVelocityDimensions         3;
    nSizeMoments                6;
    basicQuadrature
    {
        univariateMomentInversion   Gauss;
    }
}

momentAdvection
{
    velocityMomentAdvection   Vikas;
    inlet
    {
        type    symmetry;
    }
    outlet
    {
        type    reflective;
        e       1.0;
    }
    innerWall
    {
        type    reflective;
        e       1.0;
    }
    outerWall
    {
        type    reflective;
        e       1.0;
    }
}
