FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The mean temperature of the environments, which the mixing model gives the
// thermo at every step; the value at the inlet only sets the density the
// mass flux is taken with
dimensions      [0 0 0 1 0 0 0];

internalField   uniform 1110;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1110;
    }

    outlet
    {
        type            zeroGradient;
    }

    sides
    {
        type            empty;
    }
}

