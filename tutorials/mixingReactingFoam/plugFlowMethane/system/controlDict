FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     mixingReactingFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         12;

deltaT          0.001;

writeControl    adjustable;

writeInterval   12;

purgeWrite      0;

writeFormat     ascii;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.5;

maxDeltaT       0.05;

functions
{
    // The mass flow through the inlet, which the residence time of the fluid
    // along the pipe is taken with
    inletMassFlow
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        regionType      patch;
        name            inlet;
        operation       sum;
        fields          (phi);
        writeFields     no;
        writeControl    writeTime;
    }

    // The temperature of every environment, which the chemistry model keeps
    // in fields of the registry that are not written with the time
    // directories
    writeEnvironments
    {
        type            writeObjects;
        libs            (utilityFunctionObjects);
        objects         (T.node0.mixing T.node1.mixing T.node2.mixing);
        writeControl    writeTime;
    }
}

