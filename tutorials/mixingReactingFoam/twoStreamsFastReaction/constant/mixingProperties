FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      mixingProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

mixingModel conditionalMixing;

conditionalMixingCoeffs
{
    // The compositions are the species of the thermo, in the order of its
    // species list

    diffusionModel
    {
        mixingDiffusionModel  turbulentDiffusion;
        gammaLam    gammaLam [ 0 2 -1 0 0 0 0 ] 1.0e-6;
        Sc          0.7;
    }

    mixingKernel
    {
        mixingKernel  IEM;
        Cphi          Cphi    [ 0 0 0 0 0 0 0 ] 2.0;
    }

    // The chemistry of the case solved in every environment, at the
    // temperature of the cell
    reaction
    {
        reactionModel   chemistry;
        temperature     isothermal;
    }

    // The absolute tolerance is measured against the scale of every moment,
    // and a moment of the mixture fraction with a species that is absent from
    // a cell starts from zero there, where the relative tolerance allows it
    // nothing: with the mixing rates of this channel, of thousands per second
    // by the inlets, a tighter one asks for steps below the floor
    odeCoeffs
    {
        solveOde   on;
        ATol       1.0e-4;
        RTol       1.0e-4;
        fac        0.9;
        facMin     0.5;
        facMax     2.0;
        minLocalDt 1.0e-5;
    }
}

