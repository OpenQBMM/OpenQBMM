FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermo.liquid;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The species have the properties of the liquid of twoStreamsQMOM, and the
// product the mass of the two reactants. Its R is not theirs: OpenFOAM builds
// for every reaction the difference between the thermo of its products and of
// its reactants, which for a perfect fluid divides by the difference of their
// 1/R, zero if all the species were the same liquid. The density changes by
// 4e-6 of itself for it.
A
{
    specie
    {
        molWeight       18;
    }
    equationOfState
    {
        R               3000;
        rho0            1027;
    }
    thermodynamics
    {
        Cp              4195;
        Hf              0;
    }
    transport
    {
        mu              3.645e-4;
        Pr              2.289;
    }
}

