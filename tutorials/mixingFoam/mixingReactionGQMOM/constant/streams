FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      streams;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The two streams: the reactant B in the inert gas at a mixture fraction of
// zero, and the reactant A in it at one. Their temperature is not used, since
// the environments are isothermal.
xi0
{
    T       300;

    Y
    {
        B       0.1;
        I       0.9;
    }
}

xi1
{
    T       300;

    Y
    {
        A       0.1;
        I       0.9;
    }
}

