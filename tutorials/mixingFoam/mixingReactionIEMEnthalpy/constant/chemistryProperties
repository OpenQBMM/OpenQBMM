FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      chemistryProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

chemistryType
{
    solver          ode;
    method          standard;
}

chemistry               on;

initialChemicalTimeStep 1e-7;

// The reaction model integrates every environment with this solver.
// seulex breaks down on this one-step mechanism in the hottest environment
// at these tolerances, as it does in chemFoam on the same state; Rosenbrock34
// is what OpenFOAM's own methane tutorial names
odeCoeffs
{
    solver          Rosenbrock34;
    absTol          1e-12;
    relTol          1e-6;
}

