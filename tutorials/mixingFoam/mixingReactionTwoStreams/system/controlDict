FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     mixingFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         10;

deltaT          0.01;

writeControl    runTime;

writeInterval   1;

purgeWrite      0;

writeFormat     binary;     // Use binary to avoid corruption of moments

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

suppressSolverInfo yes;

functions
{
    probes
    {
        libs            (libsampling);
        type            probes;
        name            probes;
        writeControl    timeStep;
        writeInterval   1;

        fields
        (
            A
            B
            P
            I
            weight.node0.mixing
            weight.node1.mixing
            abscissa0.node0.mixing
            abscissa0.node1.mixing
        );

        probeLocations
        (
            ( 0.5 0.5 0.5 )
        );
    }
}

