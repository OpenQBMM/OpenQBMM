FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      moment.0_1_0_0_0_0.mixing;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Moment 0 of the mixture fraction with the mass fraction of O2,
// which is linear in the mixture fraction between air and fuel

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.2097;

boundaryField
{
    boundary
    {
        type            empty;
    }
}

// ************************************************************************* //
