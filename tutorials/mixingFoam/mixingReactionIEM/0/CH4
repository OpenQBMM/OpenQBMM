FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      CH4;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The mean mass fraction of CH4, which the mixing model rewrites at every
// step from the environments

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.1;

boundaryField
{
    boundary
    {
        type            empty;
    }
}

