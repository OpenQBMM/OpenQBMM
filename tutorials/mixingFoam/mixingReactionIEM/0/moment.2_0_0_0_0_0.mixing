FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      moment.2_0_0_0_0_0.mixing;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Moment 2 of the mixture fraction: a beta distribution of mean 0.1
// and variance 0.04, mostly hot air with a tail of fuel

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.05;

boundaryField
{
    boundary
    {
        type            empty;
    }
}

// ************************************************************************* //
