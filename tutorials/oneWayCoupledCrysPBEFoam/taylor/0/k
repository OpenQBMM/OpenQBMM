FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.1;

boundaryField
{
    innerWall
    {
        type            kqRWallFunction;
        value           uniform 0.1;
    }
    outerWall
    {
        type            kqRWallFunction;
        value           uniform 0.1;
    }    
    bottom
    {
        type            kqRWallFunction;
        value           uniform 0.1;
    }
    top
    {
        type            kqRWallFunction;
        value           uniform 0.1;
    }    
    front
    {
        type            wedge;
    }
    back
    {
        type            wedge;
    }
}

