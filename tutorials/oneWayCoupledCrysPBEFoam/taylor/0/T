FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 323.15; // 初始主体溶液温度 Tb = 50 C

boundaryField
{
// === 等温模式：内壁 ===
    innerWall
    {
        type            uniformFixedValue;
        uniformValue    table
        (
            (0       323.15)  // t=0s, 50.0 C
            (10154   301.15)  // t=10154s, 降至 28.0 C (斜率=0.13 C/min)
            (21600   301.15)  // t=6h, 保持 28.0 C
        );
    }

    // === 等温模式：外壁 (与内壁完全相同) ===
    outerWall
    {
        type            uniformFixedValue;
        uniformValue    table
        (
            (0       323.15)
            (10154    301.15)
            (21600   301.15)
        );
    }
    bottom
    {
        type            zeroGradient;
    }
    top
    {
        type            zeroGradient;
    }

    front
    {
        type            wedge;
    }
    back
    {
        type            wedge;
    }
}

