FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      quadratureProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

fieldMomentInversion basicVelocityFieldMomentInversion;


basicVelocityMomentInversion
{
    type CHyQMOM;
    nVelocityDimensions         2;
}

momentAdvection
{
    velocityMomentAdvection   firstOrderKinetic;

    walls
    {
        type    reflectiveRotatingWall;
        origin  (0 0 0);
        axis    (0 0 1);
        omega   5;
        e       1;
    }
}
// ************************************************************************* //
